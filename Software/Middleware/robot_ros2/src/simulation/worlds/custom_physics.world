<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="legged_world">

    <!-- Explicit gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Sun light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Inline ground plane with HIGH friction for legged robots -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000</mu>
                <mu2>1000</mu2>
              </ode>
              <torsional>
                <coefficient>100.0</coefficient>
                <patch_radius>0.05</patch_radius>
                <use_patch_radius>true</use_patch_radius>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== FUTURISTIC TEST ARENA ===== -->
    <model name="tilted_ramp">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ramp_link">
        <!-- Collision: same flat surface for robot -->
        <collision name="collision">
          <geometry><box><size>7.8 2.8 0.3</size></box></geometry>
          <surface><friction><ode><mu>1000</mu><mu2>1000</mu2></ode></friction></surface>
        </collision>
        <!-- TIER 1: Wide foundation base -->
        <visual name="tier1"><pose>0 0 -0.12 0 0 0</pose>
          <geometry><box><size>8.6 3.6 0.06</size></box></geometry>
          <material><ambient>0.03 0.03 0.05 1</ambient><diffuse>0.05 0.05 0.07 1</diffuse><specular>0.15 0.18 0.22 1</specular></material></visual>
        <!-- TIER 2: Mid layer -->
        <visual name="tier2"><pose>0 0 -0.06 0 0 0</pose>
          <geometry><box><size>8.2 3.2 0.06</size></box></geometry>
          <material><ambient>0.04 0.04 0.06 1</ambient><diffuse>0.06 0.06 0.08 1</diffuse><specular>0.18 0.20 0.25 1</specular></material></visual>
        <!-- TIER 3: Main platform surface -->
        <visual name="top_surface">
          <geometry><box><size>7.8 2.8 0.3</size></box></geometry>
          <material><ambient>0.05 0.06 0.09 1</ambient><diffuse>0.07 0.08 0.12 1</diffuse><specular>0.22 0.26 0.32 1</specular></material></visual>
        <!-- Glowing edge channels (cyan inlays around top perimeter) -->
        <visual name="ch_n"><pose>0 1.35 0.151 0 0 0</pose><geometry><box><size>7.4 0.04 0.003</size></box></geometry>
          <material><ambient>0.00 0.60 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.50 0.80 1</emissive></material></visual>
        <visual name="ch_s"><pose>0 -1.35 0.151 0 0 0</pose><geometry><box><size>7.4 0.04 0.003</size></box></geometry>
          <material><ambient>0.00 0.60 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.50 0.80 1</emissive></material></visual>
        <visual name="ch_e"><pose>3.72 0 0.151 0 0 0</pose><geometry><box><size>0.04 2.74 0.003</size></box></geometry>
          <material><ambient>0.00 0.60 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.50 0.80 1</emissive></material></visual>
        <visual name="ch_w"><pose>-3.72 0 0.151 0 0 0</pose><geometry><box><size>0.04 2.74 0.003</size></box></geometry>
          <material><ambient>0.00 0.60 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.50 0.80 1</emissive></material></visual>
        <!-- Outer amber warning edge on tier1 -->
        <visual name="warn_n"><pose>0 1.77 -0.088 0 0 0</pose><geometry><box><size>8.6 0.03 0.003</size></box></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.30 0.22 0.01 1</emissive></material></visual>
        <visual name="warn_s"><pose>0 -1.77 -0.088 0 0 0</pose><geometry><box><size>8.6 0.03 0.003</size></box></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.30 0.22 0.01 1</emissive></material></visual>
        <visual name="warn_e"><pose>4.28 0 -0.088 0 0 0</pose><geometry><box><size>0.03 3.6 0.003</size></box></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.30 0.22 0.01 1</emissive></material></visual>
        <visual name="warn_w"><pose>-4.28 0 -0.088 0 0 0</pose><geometry><box><size>0.03 3.6 0.003</size></box></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.30 0.22 0.01 1</emissive></material></visual>
        <!-- Center targeting reticle (crosshair) -->
        <visual name="ret_x"><pose>0 0 0.152 0 0 0</pose><geometry><box><size>1.6 0.01 0.002</size></box></geometry>
          <material><ambient>0.00 0.55 0.80 0.6</ambient><diffuse>0.00 0.65 0.90 0.6</diffuse><emissive>0.00 0.40 0.65 1</emissive></material></visual>
        <visual name="ret_y"><pose>0 0 0.152 0 0 0</pose><geometry><box><size>0.01 1.6 0.002</size></box></geometry>
          <material><ambient>0.00 0.55 0.80 0.6</ambient><diffuse>0.00 0.65 0.90 0.6</diffuse><emissive>0.00 0.40 0.65 1</emissive></material></visual>
        <visual name="ret_ring"><pose>0 0 0.152 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.00 0.50 0.75 0.4</ambient><diffuse>0.00 0.60 0.85 0.4</diffuse><emissive>0.00 0.35 0.60 1</emissive></material></visual>
        <visual name="ret_ring2"><pose>0 0 0.152 0 0 0</pose><geometry><cylinder><radius>0.6</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.00 0.45 0.70 0.25</ambient><diffuse>0.00 0.55 0.80 0.25</diffuse><emissive>0.00 0.30 0.55 1</emissive></material></visual>
        <!-- Grid pattern lines on surface -->
        <visual name="gx1"><pose>-2.5 0 0.151 0 0 0</pose><geometry><box><size>0.015 2.6 0.002</size></box></geometry>
          <material><ambient>0.08 0.10 0.16 1</ambient><diffuse>0.12 0.14 0.20 1</diffuse></material></visual>
        <visual name="gx2"><pose>-1.25 0 0.151 0 0 0</pose><geometry><box><size>0.015 2.6 0.002</size></box></geometry>
          <material><ambient>0.08 0.10 0.16 1</ambient><diffuse>0.12 0.14 0.20 1</diffuse></material></visual>
        <visual name="gx3"><pose>0 0 0.151 0 0 0</pose><geometry><box><size>0.015 2.6 0.002</size></box></geometry>
          <material><ambient>0.08 0.10 0.16 1</ambient><diffuse>0.12 0.14 0.20 1</diffuse></material></visual>
        <visual name="gx4"><pose>1.25 0 0.151 0 0 0</pose><geometry><box><size>0.015 2.6 0.002</size></box></geometry>
          <material><ambient>0.08 0.10 0.16 1</ambient><diffuse>0.12 0.14 0.20 1</diffuse></material></visual>
        <visual name="gx5"><pose>2.5 0 0.151 0 0 0</pose><geometry><box><size>0.015 2.6 0.002</size></box></geometry>
          <material><ambient>0.08 0.10 0.16 1</ambient><diffuse>0.12 0.14 0.20 1</diffuse></material></visual>
        <!-- Corner LED pods (larger, brighter) -->
        <visual name="pod_ne"><pose>3.6 1.2 0.151 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.00 0.65 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.55 0.80 1</emissive></material></visual>
        <visual name="pod_nw"><pose>-3.6 1.2 0.151 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.00 0.65 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.55 0.80 1</emissive></material></visual>
        <visual name="pod_se"><pose>3.6 -1.2 0.151 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.00 0.65 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.55 0.80 1</emissive></material></visual>
        <visual name="pod_sw"><pose>-3.6 -1.2 0.151 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.00 0.65 0.90 1</ambient><diffuse>0.00 0.75 1.00 1</diffuse><emissive>0.00 0.55 0.80 1</emissive></material></visual>
        <!-- Tier1 corner accent lights -->
        <visual name="t1_ne"><pose>4.15 1.65 -0.088 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.40 0.30 0.01 1</emissive></material></visual>
        <visual name="t1_nw"><pose>-4.15 1.65 -0.088 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.40 0.30 0.01 1</emissive></material></visual>
        <visual name="t1_se"><pose>4.15 -1.65 -0.088 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.40 0.30 0.01 1</emissive></material></visual>
        <visual name="t1_sw"><pose>-4.15 -1.65 -0.088 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.70 0.50 0.02 1</ambient><diffuse>0.80 0.60 0.04 1</diffuse><emissive>0.40 0.30 0.01 1</emissive></material></visual>
      </link>
    </model>

