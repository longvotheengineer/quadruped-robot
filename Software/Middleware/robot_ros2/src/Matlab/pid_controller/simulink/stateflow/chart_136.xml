      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_adj, y_adj, z_adj] = Stance_Correction(x, y, z, roll_corr, pitch_corr)
    % Ngưỡng nhận diện pha chạm đất (Stance)
    STANCE_Z = -170.0;
    STANCE_Z_THRESH = 10.0;
    
    % Mặc định output bằng input (Dùng cho pha Swing vung chân)
    x_adj = x; 
    y_adj = y; 
    z_adj = z;
    
    % Nếu chân đang chạm đất (Stance Phase) thì mới bù trừ
    if abs(z - STANCE_Z) &lt; STANCE_Z_THRESH
        cr = cos(roll_corr); sr = sin(roll_corr);
        cp = cos(pitch_corr); sp = sin(pitch_corr);
        
        % Tính Z mới. 
        % Lưu ý: X và Y bị ép giữ nguyên bằng giá trị gốc để bàn chân 
        % không bị trượt ngang trên mặt sàn
        z_adj = sp * x + sr * cp * y + cr * cp * z;
    end
end</P>
      </eml>
    </state>
