\def\makeprintversion{}

%% Remember to load babel before loading this package or define the command \abstractname!
\makeatletter
\newenvironment{abstract}{
  \clearpage
  \thispagestyle{empty}
  \@beginparpenalty\@lowpenalty
  \begin{center}
	\bfseries \fontsize{14pt}{1}\selectfont TÓM TẮT LUẬN VĂN
	\@endparpenalty\@M
  \end{center}}
 {\par\clearpage}
\makeatother

\makeatletter
\newenvironment{acknowledgments}{
	\clearpage
	\thispagestyle{empty}
	\begin{center}
	  {\bfseries \fontsize{14pt}{1}\selectfont LỜI CẢM ƠN \vspace{-.5em}\vspace{\z@}}
	\end{center}
	\quotation
  }{\endquotation\clearpage}
\makeatother

% Declaration
\makeatletter
\newenvironment{declaration}{
	\clearpage
    \thispagestyle{empty}
	\begin{center}
	  {\bfseries \fontsize{14pt}{1}\selectfont Lời cam đoan\vspace{-.5em}\vspace{\z@}}
	\end{center}
	\quotation
  }{\endquotation\clearpage}
\makeatother	  

