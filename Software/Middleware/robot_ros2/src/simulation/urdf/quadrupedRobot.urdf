<?xml version="1.0"?>
<robot name="3dof_leg">
    <!-- <link name="world_link"/> -->
    
    <!-- ── Body ─────────────────────────────────────────────── --> 

    <!-- <joint name="body_joint" type="fixed">        
        <parent link    ="world_link"/>
        <child  link    ="body_link"/>  
        <origin xyz     ="0 0 0.2"/>
    </joint> -->

    <link name="body_link">
        <visual>
            <geometry>
                <box size="0.350 0.222 0.081"/> 
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.350 0.222 0.081"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.004658" ixy="0.0"    ixz="0.0" 
                                     iyy="0.010767" iyz="0.0" 
                                                  izz="0.014333"/>
        </inertial>
    </link>

    <!-- ── Left-front leg ──────────────────────────────────── -->  

    <joint name="joint_lf_1" type="revolute">        
        <parent link    ="body_link"/>
        <child  link    ="link_lf_1"/>
        <origin xyz     ="0.125   0.0965   0.00026"
                rpy     ="0        -1.57     -3.14   "/> 
        <axis   xyz     ="0         0         1      "/>     
        <limit  lower   ="-1.57" 
                upper   =" 1.57" 
                effort  ="  29.29" 
                velocity="    5"/>  <!-- 0.2s/60deg - 30kg.cm -->
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="link_lf_1">
        <visual>
            <origin xyz="0 -0.0225 0"/>
            <geometry>
                <box size="0.01 0.045 0.01"/> 
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 -0.0225 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.01 0.045 0.01"/> 
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 -0.0225 0" rpy="0 0 0"/>
            <mass value="0.02"/>
            <inertia ixx="0.001" ixy="0.0"   ixz="0.0" 
                                 iyy="0.001" iyz="0.0" 
                                             izz="0.001"/>
        </inertial>
    </link>

    <joint name="joint_lf_2" type="revolute">
        <parent link    ="link_lf_1"/>
        <child  link    ="link_lf_2"/>
        <origin xyz     ="0    -0.045    0"
                rpy     ="1.57  3.14     0"/>
        <axis   xyz     ="0     0        1"/>
        <limit  lower   ="-6.28" 
                upper   =" 6.28" 
                effort  ="  29.29" 
                velocity="    5"/>   <!-- 0.2s/60deg - 30kg.cm -->
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="link_lf_2">
        <visual>
            <origin xyz="-0.0535 0 0"/>
