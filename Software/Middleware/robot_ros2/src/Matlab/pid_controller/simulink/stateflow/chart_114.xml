      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x, y, z] = Universal_Gait_Planner(t, leg_id)
    % Cấu hình thông số Trot
    T_swing = 0.3; T_stance = 0.7; T_cycle = T_swing + T_stance;
    stride = 40; lift = 60; z_ground = -170;

    % Cấu hình riêng biệt cho từng chân
    if leg_id == 1 % Left-Front (LF)
        phase = 0.0; x_center = 125; y_val = 135;
    elseif leg_id == 2 % Left-Behind (LB)
        phase = 0.5; x_center = -125; y_val = 135;
    elseif leg_id == 3 % Right-Front (RF)
        phase = 0.5; x_center = 125; y_val = -135;
    else % Right-Behind (RB)
        phase = 0.0; x_center = -125; y_val = -135;
    end

    % Dịch pha thời gian để tạo nhịp điệu chéo (Trot Gait)
    t_shifted = t + phase * T_cycle;
    t_mod = mod(t_shifted, T_cycle);

    % Quy hoạch Quintic
    if t_mod &lt; T_swing
        tau = t_mod / T_swing;
        s = 10*tau^3 - 15*tau^4 + 6*tau^5;
        x = (x_center - stride/2) + s * stride;
        y = y_val;
        z = z_ground + lift * 4 * s * (1 - s);
    else
        tau = (t_mod - T_swing) / T_stance;
        s = 10*tau^3 - 15*tau^4 + 6*tau^5;
        x = (x_center + stride/2) - s * stride;
        y = y_val;
        z = z_ground;
    end
end</P>
      </eml>
