<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="legged_world">

    <!-- Explicit gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Sun light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Inline ground plane with HIGH friction for legged robots -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000</mu>
                <mu2>1000</mu2>
              </ode>
              <torsional>
                <coefficient>100.0</coefficient>
                <patch_radius>0.05</patch_radius>
                <use_patch_radius>true</use_patch_radius>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tilted ramp for balance testing (10° pitch) -->
    <model name="tilted_ramp">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>  <!-- x=0.8m ahead, tilted 10° pitch -->
      <link name="ramp_link">
        <collision name="collision">
          <geometry>
            <box><size>7.8 2.8 0.3</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1000</mu><mu2>1000</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>7.8 2.8 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.1 1</ambient>
            <diffuse>0.8 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physics engine: tuned for legged robot -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>