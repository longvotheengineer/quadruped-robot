<?xml version="1.0"?>
<robot name="3dof_leg">

    <link name="world_link"/>

    <!-- ================        BODY        ================ --> 
    <joint name="body_joint" type="fixed">        
        <parent link    ="world_link"/>
        <child  link    ="body_link"/>  
        <origin xyz     ="0 0 0.5"/>
    </joint>

    <link name="body_link">
        <visual>
            <geometry>
                <box size="0.3 0.18049 0.06"/> 
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.3 0.18049 0.06"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.003015" ixy="0" ixz="0"
                     iyy="0.007800" iyz="0"
                     izz="0.010215"/>
        </inertial>
    </link>

    <!-- ================   LEFT-FRONT LEG   ================ -->  
