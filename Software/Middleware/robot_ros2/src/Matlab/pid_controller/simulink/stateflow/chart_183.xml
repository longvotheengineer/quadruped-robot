      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_out, y_out, z_out] = Universal_FK(th1, th2, th3, leg_id)
    L = 209; W = 191; l1 = 26; l2 = 106; l3 = 125;

    if leg_id == 1 || leg_id == 2
        th1_true = -th1; sign_l1 = -1;
    else
        th1_true = th1; sign_l1 = 1;
    end

    p1 = l2 * cos(th2) + l3 * cos(th2 + th3);
    p2 = l2 * sin(th2) + l3 * sin(th2 + th3);

    % Ma trận nghịch đảo 2D
    if leg_id == 1 || leg_id == 2
        x_ik = p1 * cos(th1_true) + l1 * sin(th1_true);
        y_ik = p1 * sin(th1_true) - l1 * cos(th1_true);
    else
        x_ik = p1 * cos(th1_true) - l1 * sin(th1_true);
        y_ik = p1 * sin(th1_true) + l1 * cos(th1_true);
    end
    z_ik = p2;

    % Ánh xạ về Body frame
    if leg_id == 1 % LF
        x_out = z_ik + L/2; y_out = W/2 - y_ik; z_out = x_ik;
    elseif leg_id == 2 % LB
        x_out = z_ik - L/2; y_out = W/2 - y_ik; z_out = x_ik;
    elseif leg_id == 3 % RF
        x_out = z_ik + L/2; y_out = -W/2 - y_ik; z_out = x_ik;
    else % RB
        x_out = z_ik - L/2; y_out = -W/2 - y_ik; z_out = x_ik;
    end
end</P>
      </eml>
