      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [th1, th2, th3] = Universal_IK(x, y, z, leg_id)
    L = 209; W = 191; l1 = 26; l2 = 106; l3 = 125;

    % Phân định hệ tọa độ theo chân
    if leg_id == 1 % LF
        x_ik = z; y_ik = W/2 - y; z_ik = -L/2 + x;
        sign_s3 = -1; sign_p2 = 1; invert_th1 = 1; sign_l1 = -1;
    elseif leg_id == 2 % LB
        x_ik = z; y_ik = W/2 - y; z_ik = L/2 + x;
        sign_s3 = -1; sign_p2 = 1; invert_th1 = 1; sign_l1 = -1;
    elseif leg_id == 3 % RF
        x_ik = z; y_ik = -W/2 - y; z_ik = -L/2 + x;
        sign_s3 = 1; sign_p2 = -1; invert_th1 = 0; sign_l1 = 1;
    else % RB
        x_ik = z; y_ik = -W/2 - y; z_ik = L/2 + x;
        sign_s3 = 1; sign_p2 = -1; invert_th1 = 0; sign_l1 = 1;
    end

    % Giải phương trình th1 gốc (Có fix lỗi p1)
    th1_true = atan2(-x_ik, y_ik) + atan2(-sqrt(x_ik^2 + y_ik^2 - l1^2), sign_l1 * l1);
    p1 = x_ik * cos(th1_true) + y_ik * sin(th1_true);

    if invert_th1
        th1 = -th1_true;
    else
        th1 = th1_true;
    end

    p2 = sign_p2 * z_ik;
    c3 = (p1^2 + p2^2 - l2^2 - l3^2) / (2 * l2 * l3);
    % --- CHỐNG TRẬT KHỚP (SAFETY CLAMP) ---
    c3 = max(-1, min(1, c3)); 
    % -------------------------------------
    s3 = sign_s3 * sqrt(1 - c3^2);
    th3 = atan2(s3, c3);
    th2 = atan2(p2, p1) - atan2(l3 * s3, l2 + l3 * c3);

    % Chuẩn hóa góc th2 cho mô phỏng
    if leg_id == 1 || leg_id == 4
        if th2 &lt; 0; th2 = th2 + 2*pi; end
    elseif leg_id == 2 || leg_id == 3
        if th2 &gt; 0; th2 = th2 - 2*pi; end
    end
end</P>
      </eml>
