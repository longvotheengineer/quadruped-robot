      <link name="l"><visual name="v"><geometry><box><size>50 0.3 24</size></box></geometry>
        <material><ambient>0.10 0.10 0.13 1</ambient><diffuse>0.14 0.14 0.17 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -20 12 0 0 0</pose>
