# ==========================
# MATLAB & Simulink
# ==========================
# Autosave and backup files (Crucial for keeping history clean)
*.asv
*.autosave
*.bak

# Simulink project and cache directories
slprj/
*_slprj/
sfprj/
*.slxc
*.sldi

# MEX files (Compiled MATLAB binaries)
*.mex*
*.mexw64
*.mexmaci64
*.mexa64

# MATLAB Profiler and memory files
*.mat
# NOTE: If you need to commit specific small .mat configuration files,
# you can force add them with: git add -f filename.mat

# ==========================
# CoppeliaSim (V-REP)
# ==========================
# Backup scenes and temp files
*.ttt.backup
*.ttt.tmp

# ==========================
# ROS 2 & colcon
# ==========================
# Build, install and log directories
build/
devel/
install/
log/
iso/

# Catkin / Colcon workspace markers
.catkin_workspace
.colcon_ignore
COLCON_IGNORE

# Bag files (Large recordings — usually shouldn't be on Git)
*.bag
*.mcap

# ROS 2 workspace specific paths
Software/Middleware/robot_ros2/build/
Software/Middleware/robot_ros2/install/
Software/Middleware/robot_ros2/log/

# ==========================
# Python
# ==========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.env

# Distribution / packaging
*.egg-info/
*.egg
dist/

# ==========================
# C / C++
# ==========================
# Prerequisites
*.d

# Object files
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (dynamic libraries)
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# ==========================
# LaTeX Build Artifacts
# ==========================
*.aux
*.log
*.synctex.gz
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.blg
*.bbl
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.glg
*.glo
*.gls
*.ist

# ==========================
# Gazebo
# ==========================
*.world.backup
.gazebo/

# ==========================
# Editor / IDE Directories
# ==========================
# VS Code
.vscode/
*.code-workspace

# ==========================
# OS Generated Files
# ==========================
.DS_Store
Thumbs.db
