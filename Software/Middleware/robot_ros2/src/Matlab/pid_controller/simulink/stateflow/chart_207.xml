      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [roll_meas, pitch_meas] = IMU_Simulator(z1, z2, z3, z4, zref1, zref2, zref3, zref4)
    persistent last_pitch last_roll
    if isempty(last_pitch)
        last_pitch = 0;
        last_roll = 0;
    end
    
    DIAG_X_DIST = 250; % Khoảng cách X giữa 2 chân chéo
    DIAG_Y_DIST = 191; % Khoảng cách Y giữa chân Trái và Phải
    
    THRESH = -168; 
    s1 = zref1 &lt; THRESH; % LF 
    s2 = zref2 &lt; THRESH; % LB 
    s3 = zref3 &lt; THRESH; % RF 
    s4 = zref4 &lt; THRESH; % RB 
    
    pitch_sum = 0; roll_sum = 0; count = 0;
    
    % TÍNH GÓC CHÉO:
    % Pitch: Trái-Trước (z1) trừ Phải-Sau (z4)
    % Roll: Trái (z1) trừ Phải (z4) -&gt; Nghiêng Phải ra góc Dương
    if s1 &amp;&amp; s4
        pitch_sum = pitch_sum + atan2(z1 - z4, DIAG_X_DIST); 
        roll_sum = roll_sum + atan2(z1 - z4, DIAG_Y_DIST);
        count = count + 1;
    end
    if s2 &amp;&amp; s3
        pitch_sum = pitch_sum + atan2(z3 - z2, DIAG_X_DIST); 
        roll_sum = roll_sum + atan2(z2 - z3, DIAG_Y_DIST); % Trái (z2) - Phải (z3)
        count = count + 1;
    end
    
    if count &gt; 0
        base_pitch = pitch_sum / count;
        base_roll = roll_sum / count;
        
        last_pitch = base_pitch;
        last_roll = base_roll;
    else
        base_pitch = last_pitch;
        base_roll = last_roll;
    end
    
    % --- BƠM NHIỄU KHUNG GẦM &amp; NHIỄU TRẮNG CHO CẢ 2 TRỤC ---
    is_swinging = (zref1 &gt; THRESH) || (zref2 &gt; THRESH);
    if is_swinging
        gait_noise_p = 0.1 * sin(2 * pi * 2 * (zref1/170)); 
        gait_noise_r = 0.05 * cos(2 * pi * 2 * (zref1/170)); % Roll thường lắc nhẹ hơn Pitch
    else
        gait_noise_p = -0.1 * sin(2 * pi * 2 * (zref2/170));
        gait_noise_r = -0.05 * cos(2 * pi * 2 * (zref2/170));
    end
    
    pitch_meas = base_pitch + gait_noise_p + 0.05 * randn();
    roll_meas = base_roll + gait_noise_r + 0.05 * randn();
end</P>
      </eml>
