<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="legged_world">

    <!-- gazebo_ros_state: exposes /gazebo/set_entity_state and
         /gazebo/get_entity_state services used by node_ramp_mover -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Explicit gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Sun light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane with high friction for legged robots -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000</mu>
                <mu2>1000</mu2>
              </ode>
              <torsional>
                <coefficient>100.0</coefficient>
                <patch_radius>0.05</patch_radius>
                <use_patch_radius>true</use_patch_radius>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple tilted ramp -->
    <model name="tilted_ramp">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ramp_link">
        <collision name="collision">
          <geometry><box><size>8.0 8.0 0.5</size></box></geometry>
          <surface><friction><ode><mu>1000</mu><mu2>1000</mu2></ode></friction></surface>
        </collision>
        <!-- Translucent white surface -->
        <visual name="top_surface">
          <geometry><box><size>8.0 8.0 0.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.88 0.4</ambient>
            <diffuse>0.92 0.92 0.95 0.4</diffuse>
            <specular>0.6 0.6 0.65 1</specular>
          </material>
        </visual>
        <!-- Grid lines along X axis -->
        <visual name="gx1"><pose>-3.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx2"><pose>-2.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx3"><pose>-1.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx4"><pose>0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx5"><pose>1.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx6"><pose>2.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gx7"><pose>3.0 0 0.251 0 0 0</pose><geometry><box><size>0.01 8.0 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <!-- Grid lines along Y axis -->
        <visual name="gy1"><pose>0 -3.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy2"><pose>0 -2.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy3"><pose>0 -1.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy4"><pose>0 0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy5"><pose>0 1.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy6"><pose>0 2.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <visual name="gy7"><pose>0 3.0 0.251 0 0 0</pose><geometry><box><size>8.0 0.01 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Physics engine: tuned for legged robot -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>

      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>