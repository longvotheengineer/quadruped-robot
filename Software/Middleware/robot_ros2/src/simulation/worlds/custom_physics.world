<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="legged_world">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1000</mu>
                <mu2>1000</mu2>
              </ode>
              <torsional>
                <coefficient>100.0</coefficient>
                <patch_radius>0.05</patch_radius>
                <use_patch_radius>true</use_patch_radius>
              </torsional>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <max_vel>0.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== SQUARE LARGE RAMP ===== -->
    <model name="tilted_ramp">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ramp_link">
        <collision name="collision">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><box><size>20 20 1.0</size></box></geometry>
          <surface><friction><ode><mu>1000</mu><mu2>1000</mu2></ode></friction></surface>
        </collision>
        <visual name="top_surface">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><box><size>20 20 1.0</size></box></geometry>
          <material>
             <ambient>0.6 0.6 0.6 1</ambient>
             <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

        <visual name="grid_x_-9">
          <pose>-9 0 0.151 0 0 0</pose>
          <geometry><box><size>0.02 20 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="grid_y_-9">
          <pose>0 -9 0.151 0 0 0</pose>
          <geometry><box><size>20 0.02 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
